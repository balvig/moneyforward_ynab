SECRETS=$(kamal secrets fetch --adapter 1password --account my --from "op://Private/MFYNAB" YNAB_ACCESS_TOKEN GHCR_REGISTRY_PASSWORD)

YNAB_ACCESS_TOKEN=$(kamal secrets extract YNAB_ACCESS_TOKEN $SECRETS)
GHCR_REGISTRY_PASSWORD=$(kamal secrets extract GHCR_REGISTRY_PASSWORD $SECRETS)

# Money Forward session cookie, generated by running mfynab once locally.
# Priming the container with it avoids the email-2FA challenge that a fresh
# login from the server would trigger.
COOKIE_CACHE_PRIME=$(cat ~/.config/mfynab/cookie)
